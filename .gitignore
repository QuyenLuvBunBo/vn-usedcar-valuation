# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/
env/

# Secrets / cấu hình cục bộ (vẫn giữ file mẫu .env.example)
.env
.env.*
!.env.example

# Dữ liệu cào được (không commit dữ liệu thô, chỉ giữ khung thư mục)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/master/*
!data/master/.gitkeep
data/*.db
*.sqlite3

# Notebook: bỏ checkpoint, giữ file .ipynb (nên strip output trước khi commit)
.ipynb_checkpoints/

# Log & checkpoint
logs/*
!logs/.gitkeep
*.log
.ckpt.json

# Mô hình & artifact dẫn xuất của preprocessing (tuần 3):
# nhị phân, sinh lại được bằng một lệnh, chia sẻ qua Drive — repo đang PUBLIC nên
# mọi thứ commit vào đây là công khai vĩnh viễn trong lịch sử git.
# Root-anchored: `src/models/` is source code and must stay tracked.
/models/
*.joblib
*.pkl
*.cbm

# Ma trận OOF và bảng dòng kèm target: `train_*_oof_rows.csv` chứa price_vnd/y_log
# (target) + listing_id, nên tuyệt đối không commit. Xem docs/data_handover.md §5.
encoded/
*.npz
*_oof_rows.csv


# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# CatBoost writes its training log into the working directory
catboost_info/
