# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# URL gốc của trang cần cào
BASE_URL=

# Header/session (lấy từ DevTools -> Network -> Copy as cURL)
COOKIE=
AUTHORIZATION=

# Proxy xoay vòng (tùy chọn): http://user:pass@host:port
PROXY_URL=

# Tham số cào
REQUEST_DELAY=1.5
MAX_RETRIES=3
TIMEOUT=20
